{
  "name": "javicale-playwright-quality-engineering",
  "version": "1.0.0",
  "private": true,
  "description": "Quality Engineering reference framework using Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
